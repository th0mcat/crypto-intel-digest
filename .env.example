# Copy to .env and fill in. Never commit .env.
#
# MODE SELECTION — run in exactly ONE of the two modes below.
# If Telegram credentials are fully set, Telegram mode is used regardless
# of Matrix vars. If only Matrix vars are set, Matrix mode is used.
# If neither is fully configured the bot exits immediately with an error.
#
# Minimal Telegram-mode .env:
#   TELEGRAM_BOT_TOKEN=123456:AAFxxxxxxx
#   TELEGRAM_OPERATOR_ID=123456789
#
# Minimal Matrix-mode .env:
#   MATRIX_HOMESERVER_URL=https://matrix.example.org
#   MATRIX_USER_ID=@bot:example.org
#   MATRIX_ACCESS_TOKEN=syt_...
#   MATRIX_ROOM_ID=!abc123:example.org

# --- Telegram mode (leave blank for Matrix-only) ---
# From @BotFather on Telegram
TELEGRAM_BOT_TOKEN=

# Your numeric Telegram user id (message @userinfobot to get it).
# The bot ignores everyone except this id.
TELEGRAM_OPERATOR_ID=

# Postgres (used by compose to create the db and build DATABASE_URL)
POSTGRES_USER=intel
POSTGRES_PASSWORD=change-me
POSTGRES_DB=intel

# Optional: healthchecks.io ping URL for the external dead-man's switch.
# Leave empty to disable (you'll get a log warning, not a failure).
HEALTHCHECK_URL=

# --- Phase 1 collectors ---

# Reddit: create a "script" app at https://www.reddit.com/prefs/apps
# Leave blank to run without the Reddit collector (RSS + NVD still work).
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=intel-system/0.2 (by operator)

# NVD: optional free key raises the rate limit (works without it).
# https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=

# Daily brief send time, UTC hour (0-23).
DIGEST_HOUR_UTC=7

# Triage keep threshold (0-1). Lower = more survives to the digest.
TRIAGE_KEEP_THRESHOLD=0.45

# --- Matrix mode (all four fields required; leave blank for Telegram-only) ---
# Precedence: if TELEGRAM_BOT_TOKEN + TELEGRAM_OPERATOR_ID are both set,
# Telegram mode is used even if Matrix vars are also present.
#
# Your self-hosted homeserver base URL, e.g. https://matrix.example.org
MATRIX_HOMESERVER_URL=
# Bot's own Matrix user id, e.g. @bot:example.org
MATRIX_USER_ID=
# Access token for the bot account (preferred over password).
# In Element: Settings → Help & About → Access Token.
MATRIX_ACCESS_TOKEN=
# Fallback if no token is available: the bot's password.
# Token auth is strongly preferred for bots on self-hosted servers.
MATRIX_PASSWORD=
# The room the bot operates in and sends digests to, e.g. !abc123:example.org
MATRIX_ROOM_ID=
# Only this Matrix user id may send commands (!status, !digest, …).
# Everyone else is silently ignored, mirroring TELEGRAM_OPERATOR_ID behaviour.
MATRIX_OPERATOR_USER_ID=
