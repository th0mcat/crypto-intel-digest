# Copy to .env and fill in. Never commit .env.

# From @BotFather on Telegram
TELEGRAM_BOT_TOKEN=

# Your numeric Telegram user id (message @userinfobot to get it).
# The bot ignores everyone except this id.
TELEGRAM_OPERATOR_ID=

# Postgres (used by compose to create the db and build DATABASE_URL)
POSTGRES_USER=intel
POSTGRES_PASSWORD=change-me
POSTGRES_DB=intel

# Optional: healthchecks.io ping URL for the external dead-man's switch.
# Leave empty to disable (you'll get a log warning, not a failure).
HEALTHCHECK_URL=

# --- Phase 1 collectors ---

# Reddit: create a "script" app at https://www.reddit.com/prefs/apps
# Leave blank to run without the Reddit collector (RSS + NVD still work).
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=intel-system/0.2 (by operator)

# NVD: optional free key raises the rate limit (works without it).
# https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=

# Daily brief send time, UTC hour (0-23).
DIGEST_HOUR_UTC=7

# Triage keep threshold (0-1). Lower = more survives to the digest.
TRIAGE_KEEP_THRESHOLD=0.45
