# This file is no longer used by the bot itself.
#
# Since the bot is now a maubot plugin, all configuration lives in
# base-config.yaml and is managed through the maubot management UI:
#
#   https://<your-maubot-instance>/_matrix/maubot/
#
# The values below are still useful when running the PostgreSQL database
# via the provided docker-compose.yml for local development.

# Postgres (used by compose to create the db and build the connection string)
POSTGRES_USER=intel
POSTGRES_PASSWORD=change-me
POSTGRES_DB=intel
